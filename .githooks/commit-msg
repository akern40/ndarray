#!/bin/sh
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"
if command -v committed >/dev/null 2>&1; then
  exec committed --commit-file "$1"
elif command -v mise >/dev/null 2>&1; then
  exec mise exec -- committed --commit-file "$1"
fi
echo "commit-msg hook: 'committed' not found; install mise and run 'mise install'" >&2
exit 1
